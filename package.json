{
  "name": "gen-con-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "node scripts/scrape.mjs",
    "bundle": "node scripts/bundle.mjs",
    "build:desktop": "VITE_BASE=/ vite build",
    "electron:dev": "npm run build:desktop && electron electron/main.cjs",
    "dist": "npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:mac": "npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:linux": "npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux"
  },
  "build": {
    "appId": "com.pixelbandito.gen-con-planner",
    "productName": "Gen Con Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "public/data/events.json",
        "to": "data/events.json"
      }
    ],
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
